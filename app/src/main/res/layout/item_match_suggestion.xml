<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_match_rank"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:textColor="#E91E63"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1" />

        <TextView
            android:id="@+id/tv_match_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_match_percent"
            app:layout_constraintStart_toEndOf="@+id/tv_match_rank"
            app:layout_constraintTop_toTopOf="@+id/tv_match_rank"
            tools:text="Alex Perera" />

        <TextView
            android:id="@+id/tv_match_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_done"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_match_rank"
            tools:text="88% match" />

        <TextView
            android:id="@+id/tv_match_location_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:textColor="#757575"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_match_rank"
            app:layout_constraintTop_toBottomOf="@+id/tv_match_name"
            tools:text="Colombo · Software Developer" />

        <TextView
            android:id="@+id/tv_match_ecr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_match_rank"
            app:layout_constraintTop_toBottomOf="@+id/tv_match_location_line"
            tools:text="ECR-RS · Anxiety 3.2 · Avoidance 4.1 (1–7)" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_match_strength"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:max="100"
            app:indicatorColor="#E91E63"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_match_rank"
            app:layout_constraintTop_toBottomOf="@+id/tv_match_ecr"
            app:trackColor="#FCE4EC"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp"
            tools:progress="88" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_match_say_hello"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:text="@string/match_suggestion_say_hello"
            android:textAllCaps="false"
            android:textColor="#E91E63"
            android:textSize="15sp"
            app:cornerRadius="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_match_rank"
            app:layout_constraintTop_toBottomOf="@+id/progress_match_strength"
            app:strokeColor="#E91E63"
            app:strokeWidth="2dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
