SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
# Optional if the file at repo root is named matchmind_hybrid_v4.pth (default in code).
# On Render: set MODEL_PATH only if your committed filename differs.
# MODEL_PATH=matchmind_hybrid_v4.pth

# Optional: cuda | cpu | mps
TORCH_DEVICE=cpu

# Must match profiles.current_status for eligible candidates (schema default: looking_for_partner)
CANDIDATE_STATUS=looking_for_partner

# Optional: override checkpoint alpha (0–1). Leave unset to use value from .pth

# HYBRID_ALPHA_OVERRIDE=0.35

# Load .pth during server startup (default true locally). On Render, RENDER=true auto-skips this so the
# process binds $PORT quickly; the model loads on the first GET /get_matches instead.
# EAGER_MODEL_LOAD=false
# MATCHMIND_FORCE_EAGER_MODEL_LOAD=true
